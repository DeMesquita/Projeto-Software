@startuml
title C4 - Nível de Componentes - API de Serviços Fale Conosco

skinparam backgroundColor white

skinparam packageStyle rectangle
skinparam package {
  BackgroundColor #E3F2FD
  BorderColor #90CAF9
  RoundCorner 15
  FontColor #0D47A1
  FontSize 14
}

skinparam component {
  BackgroundColor #1976D2
  BorderColor #0D47A1
  FontColor white
  RoundCorner 10
}

skinparam ArrowColor #424242

' ----------------------------------------------------------
' Frontends e sistemas externos
' ----------------------------------------------------------
rectangle "Portal do Solicitante\n(React Web)" as portal_solic #EEEEEE
rectangle "Aplicação Backoffice\n(React Web)" as backoffice    #EEEEEE
rectangle "Sistema de Autenticação" as auth_system             #DDDDDD
database  "Base de Dados\n(PostgreSQL)" as db                  #FFFFFF

' ----------------------------------------------------------
' Boundary da API de Serviços
' ----------------------------------------------------------
package "API de Serviços\n(Aplicação Java REST)" {

  ' ---------------- Camada de Controllers -----------------
  package "Camada de Controllers" {

    component "UsuarioController\n<<REST Controller>>"        as UsuarioController
    component "EstatisticasController\n<<REST Controller>>"   as EstatisticasController
    component "FilaController\n<<REST Controller>>"           as FilaController
    component "UnidadeController\n<<REST Controller>>"        as UnidadeController
    component "AtendimentoController\n<<REST Controller>>"    as AtendimentoController
    component "ChatGateway\n<<WebSocket Gateway>>"            as ChatGateway
  }

  ' ---------------- Camada de Services --------------------
  package "Camada de Services\n(Regras de negócio)" {

    component "UsuarioService\n<<Service>>"        as UsuarioService
    component "EstatisticasService\n<<Service>>"   as EstatisticasService
    component "FilaService\n<<Service>>"           as FilaService
    component "UnidadeService\n<<Service>>"        as UnidadeService
    component "AtendimentoService\n<<Service>>"    as AtendimentoService
  }

  ' ---------------- Camada de Repositórios ----------------
  package "Camada de Repositórios\n(Persistência)" {

    component "UsuarioRepository\n<<Repository>>"       as UsuarioRepository
    component "EstatisticasRepository\n<<Repository>>"  as EstatisticasRepository
    component "AtendimentoRepository\n<<Repository>>"   as AtendimentoRepository
    component "UnidadeRepository\n<<Repository>>"       as UnidadeRepository
  }

  ' ---------------- Integração externa --------------------
  component "AuthClient\n<<HTTP Client>>" as AuthClient
}

' ----------------------------------------------------------
' Relacionamentos – frontends -> API
' ----------------------------------------------------------
portal_solic --> AtendimentoController  : abrir / consultar atendimento\n(HTTPS/JSON)
portal_solic --> UsuarioController      : autenticação / dados do solicitante\n(HTTPS/JSON)

backoffice   --> AtendimentoController  : gerenciar atendimentos\n(HTTPS/JSON)
backoffice   --> FilaController         : gerenciar fila\n(HTTPS/JSON)
backoffice   --> UnidadeController      : gerenciar unidades\n(HTTPS/JSON)
backoffice   --> EstatisticasController : consultar estatísticas\n(HTTPS/JSON)
backoffice   --> ChatGateway            : eventos de chat\n(WebSocket)

' ----------------------------------------------------------
' Relacionamentos – controllers -> services
' ----------------------------------------------------------
UsuarioController      --> UsuarioService
EstatisticasController --> EstatisticasService
FilaController         --> FilaService
UnidadeController      --> UnidadeService
AtendimentoController  --> AtendimentoService
ChatGateway            --> AtendimentoService : envia eventos de chat

' ----------------------------------------------------------
' Relacionamentos – services -> repositories / integrações
' ----------------------------------------------------------
UsuarioService      --> UsuarioRepository
EstatisticasService --> EstatisticasRepository
AtendimentoService  --> AtendimentoRepository
FilaService         --> AtendimentoRepository : consulta pendentes
UnidadeService      --> UnidadeRepository

AtendimentoService  --> AuthClient      : consulta perfis/autenticação\n(HTTPS)
AuthClient          --> auth_system     : integra com sistema de autenticação\n(HTTPS)

UsuarioRepository       --> db
EstatisticasRepository  --> db
AtendimentoRepository   --> db
UnidadeRepository       --> db

@enduml

