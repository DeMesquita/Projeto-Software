@startuml

title C4 - Nível de Componentes - API de Serviços Fale Conosco

package "API de Serviços (Aplicação Java REST)" {

  package "Camada de Controllers" {
    [AtendimentoController] <<REST Controller>>
    [FilaController] <<REST Controller>>
    [UnidadeController] <<REST Controller>>
    [UsuarioController] <<REST Controller>>
    [EstatisticasController] <<REST Controller>>
    [ConfiguracaoController] <<REST Controller>>
  }

  package "Camada de Services (Regras de Negócio)" {
    [AtendimentoService] <<Service>>
    [FilaService] <<Service>>
    [UnidadeService] <<Service>>
    [UsuarioService] <<Service>>
    [EstatisticasService] <<Service>>
    [ConfiguracaoService] <<Service>>
    [AuthClient] <<HTTP Client>>
    [ChatGateway] <<WebSocket Gateway>>
  }

  package "Camada de Repositórios (Persistência)" {
    [AtendimentoRepository] <<Repository>>
    [UsuarioRepository] <<Repository>>
    [UnidadeRepository] <<Repository>>
    [EstatisticasRepository] <<Repository>>
    [ConfiguracaoRepository] <<Repository>>
  }
}

' ---- Relações principais ----

' Controllers -> Services
[AtendimentoController] --> [AtendimentoService]
[FilaController] --> [FilaService]
[UnidadeController] --> [UnidadeService]
[UsuarioController] --> [UsuarioService]
[EstatisticasController] --> [EstatisticasService]
[ConfiguracaoController] --> [ConfiguracaoService]

' Services -> Repositórios
[AtendimentoService] --> [AtendimentoRepository]
[FilaService] --> [AtendimentoRepository]
[UnidadeService] --> [UnidadeRepository]
[UsuarioService] --> [UsuarioRepository]
[EstatisticasService] --> [EstatisticasRepository]
[ConfiguracaoService] --> [ConfiguracaoRepository]

' Integração com Sistema de Autenticação
[UsuarioService] --> [AuthClient] : consulta perfis/autenticação

' Chat em tempo real
[ChatGateway] --> [AtendimentoService] : envia eventos de chat

' Repositórios -> Banco de Dados (representado como um componente lógico)
database "Base de Dados\n(PostgreSQL)" as DB

[AtendimentoRepository] --> DB
[UsuarioRepository] --> DB
[UnidadeRepository] --> DB
[EstatisticasRepository] --> DB
[ConfiguracaoRepository] --> DB

@enduml
